rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =====================================================================
    // v1 KAPSAMI
    //
    // Serbest metinli kullanıcı içeriği (gönderi, yorum, kanal, DM) v1'de
    // YOKTUR. Gerekçe: App Store 1.2 (UGC) 24 saat içinde insan müdahalesi
    // taahhüdü, AB DSA yükümlülükleri ve CSAM tespit sorumluluğu sürekli bir
    // moderasyon operasyonu gerektiriyor.
    //
    // Sosyal katman serbest metin içermez: arkadaşlık, seri görünürlüğü,
    // KAPALI BİR KÜMEDEN seçilen hazır tepkiler ve günlük ikili dinamik.
    //
    // Kaldırılan koleksiyonlar (posts, comments, likes, channels,
    // subscribers, chats, following, followers) bu dosyada bilinçli olarak
    // ele alınmıyor: Firestore'da eşleşmeyen yol varsayılan olarak reddedilir.
    // =====================================================================

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Görünen adın SUİSTİMAL TAVANI — arayüz sınırının kopyası DEĞİL.
    //
    // İstemci 40 rune ile sınırlıyor (`kDisplayNameMaxChars`,
    // account_screen.dart) ama kural katmanında hiçbir sınır yoktu: değişmiş
    // bir istemci megabaytlık bir ad yazabilirdi ve o ad `publicProfiles`
    // üzerinden BAŞKA kullanıcılara gider (arkadaş listesi, rehber eşleşmesi).
    //
    // Sayı bilerek 40 DEĞİL 64: iki katman aynı sayıyı tutarsa bir gün
    // ayrışırlar ve ayrışma sessiz olur — kullanıcı arayüzde kabul edilen bir
    // adı kaydedemez, hata da `permission-denied` diye çıkar (bu depoda aynı
    // sınıf üç kez yaşandı: faceConsent, residenceCity, platform aynası).
    // Buradaki iş ürün kuralını TEKRARLAMAK değil, tavanı ÇİVİLEMEK.
    // Ayrıca `size()` karakter sayar, istemci rune sayar; birebir eşitlik
    // zaten garanti edilemez.
    function adBoyutuMakul() {
      return !('displayName' in request.resource.data)
        || request.resource.data.displayName.size() <= 64;
    }

    // Biyometrik işleme rızasını İSTEMCİ DEĞİŞTİREMEZ.
    //
    // Alan bir dönem yazılabilir listesinde HİÇ yoktu; amaç doğruydu ama yan
    // etkisi ağırdı. Kural motoru `merge: true` yazımlarda gönderilen alanlara
    // değil SONUÇTA oluşacak dokümana bakıyor. `faceConsent` o dokümanda
    // durduğu için `hasOnly(...)` her istemci yazımında düşüyordu:
    //
    //   Bildirim bağlamı yazılamadı: [cloud_firestore/permission-denied]
    //
    // Yani kullanıcı rıza verdikten SONRA saat dilimi, dil, FCM token, seri
    // sayacı ve profil düzenlemeleri artık hiç yazılamıyordu — sessizce.
    //
    // Alan artık listede ama DEĞİŞMEZ: merge yazımlarında olduğu gibi geçiyor,
    // istemci değerini kuramıyor ve değiştiremiyor. Yalnızca Admin SDK
    // (kuralları atlar) yazabiliyor. Özgün amaç korunuyor:
    // kullanıcı kendi rızasını uyduramaz.
    function faceConsentDegismedi() {
      return !('faceConsent' in request.resource.data)
        || (resource != null
            && 'faceConsent' in resource.data
            && request.resource.data.faceConsent == resource.data.faceConsent);
    }

    // Şartlar/gizlilik kabulü (O3) — faceConsent ile aynı model: alan
    // listede (merge yazımlar düşmesin) ama DEĞİŞMEZ; yalnız sunucu
    // (POST /account/consent, Admin SDK) yazar. Kullanıcı kendi kabul
    // kaydını uyduramaz ya da geri süremez.
    function termsConsentDegismedi() {
      return !('termsConsent' in request.resource.data)
        || (resource != null
            && 'termsConsent' in resource.data
            && request.resource.data.termsConsent == resource.data.termsConsent);
    }

    // Sürüm aynası (PBZ, K10) — faceConsent ile aynı model. `appBuild`
    // alanını SUNUCU yazar (core/auth.get_current_user, Admin SDK): her
    // kimlikli istekteki X-App-Build başlığı uid başına günde bir kez
    // buraya düşer. Alan listede (merge yazımlar düşmesin — platform
    // vakasının dersi) ama DEĞİŞMEZ: istemci kendi sürüm numarasını
    // uyduramaz. Uydurabilseydi eşik doğrulaması (K9: "eşiğin üstünde en
    // az bir kullanıcı görülmüş olmalı") ve panelin "eşiğin altında N"
    // sayımı istemcinin insafına kalırdı; sahte 999 tek başına 999'luk
    // bir eşiğin yazılmasına kapı açardı.
    //
    // AD-turu genellemesi: sunucu yazımlı alanlar çoğaldı (arama aynası
    // `emailLower/usernameLower/nameLower`, plan aynası `plan/planAt/
    // planProduct`, kimlik bayrağı `authDisabled`). Hepsi aynı modelde:
    // LİSTEDE (merge yazımlar düşmesin) ama DEĞİŞMEZ (istemci kendi
    // planını "plus" yapamaz, arama aynasını bozamaz, kendini "devre
    // dışı değil" yazamaz). Tek fonksiyon, tek liste — yeni sunucu alanı
    // bu listeye ve hasOnly'ye birlikte girer (KT1 dersi).
    function sunucuAlaniDegismedi(alan) {
      return !(alan in request.resource.data)
        || (resource != null
            && alan in resource.data
            && request.resource.data[alan] == resource.data[alan]);
    }

    function sunucuAlanlariDegismedi() {
      return sunucuAlaniDegismedi('appBuild')
        && sunucuAlaniDegismedi('emailLower')
        && sunucuAlaniDegismedi('usernameLower')
        && sunucuAlaniDegismedi('nameLower')
        && sunucuAlaniDegismedi('plan')
        && sunucuAlaniDegismedi('planAt')
        && sunucuAlaniDegismedi('planProduct')
        && sunucuAlaniDegismedi('authDisabled');
    }

    // ---------- Kullanıcı profili (HASSAS — yalnızca sahibi) ----------
    // Doğum tarihi + saati + yeri hassas bir üçlüdür (kimlik doğrulama
    // sorularında kullanılır). Firestore kuralları okumada alan filtreleyemediği
    // için bu doküman tamamen sahibine kapatıldı; arkadaşların görmesi gereken
    // alanlar ayrıca `publicProfiles/{uid}` altında tutulur.
    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && adBoyutuMakul()
        && request.resource.data.keys().hasOnly([
          'uid', 'displayName', 'photoUrl', 'email', 'username',
          'birthDate', 'birthTime', 'birthCity', 'birthNation', 'gender',
          'sunSign', 'moonSign', 'ascendant', 'wuXingElement', 'mizac',
          'onboardingCompleted', 'createdAt', 'updatedAt', 'fcmToken', 'fcmTokenAt', 'bio',
          // Günlük seri (motivasyon): son görülen gün + seri sayacı
          'lastSeenDaily', 'streakCount',
          // Serimi arkadaşlarım görebilsin mi (varsayılan: kapalı)
          'streakVisible',
          // Rehber eşleşmesi (varsayılan: KAPALI). Karşılıklılık şartının
          // yarısı: sunucu eşleşme dönerken iki tarafın da bu alanı açmış
          // olmasını arar. Telefon hash'inin kendisi BURADA DEĞİL —
          // sunucu yazımlı phoneHashes/{hash} + private/phone'da.
          'contactMatch',
          // ---------- Bildirimler ----------
          // Saat dilimi IANA adıdır ("Europe/Istanbul"); sunucu kullanıcının
          // YEREL saatini bununla hesaplar. Doğum şehri kullanılamaz: kişi
          // doğduğu yerde yaşamıyor olabilir.
          'timezone',
          // Arayüz dili: bildirim metni sunucuda üretildiği için istemcinin
          // Accept-Language başlığı burada yok; dil profilde tutulur.
          'language',
          // Tercihler (varsayılan açık) ve sessiz saat aralığı (yerel saat).
          'notifyDaily', 'notifyStreak', 'notifyFriends',
          'quietFrom', 'quietTo',
          // Yaşanan şehir (D3): Yıl Haritası bu konuma kurulur. Alan D3'te
          // eklendi ama bu listeye GİRMEMİŞTİ — dialog üretimde
          // permission-denied ile düşüyordu (faceConsent olayının aynısı;
          // motor merge'de SONUÇ dokümana bakar). O2'de kapatıldı.
          'residenceCity', 'residenceNation',
          // Platform aynası (AP4): SUNUCU yazar (device claim, Admin SDK)
          // ama motor merge'de SONUÇ dokümana baktığı için alan listede
          // olmazsa İSTEMCİNİN sonraki tüm profil yazımları düşer —
          // faceConsent/residenceCity vakalarının ÜÇÜNCÜSÜ (KT1'de canlıda
          // yaşandı ve kapatıldı). Ders: sunucu yazımlı alan da buraya girer.
          'platform',
          // Sürüm aynası (PBZ): SUNUCU yazar (X-App-Build → appBuild),
          // platform gibi listede, faceConsent gibi DEĞİŞMEZ (yukarıya bak).
          'appBuild',
          // Arama aynası (AD4, services/search_mirror.py) + plan aynası
          // (AD5, api/billing._mirror_plan) + kimlik bayrağı (AD4, disable
          // ucu/backfill): SUNUCU yazar, listede, DEĞİŞMEZ —
          // sunucuAlanlariDegismedi().
          'emailLower', 'usernameLower', 'nameLower',
          'plan', 'planAt', 'planProduct', 'authDisabled',
          // Biyometrik işleme rızası — LİSTEDE ama DEĞİŞMEZ (aşağıya bak).
          'faceConsent',
          // Şartlar/gizlilik kabulü (O3) — LİSTEDE ama DEĞİŞMEZ.
          'termsConsent'
        ])
        && faceConsentDegismedi()
        && termsConsentDegismedi()
        && sunucuAlanlariDegismedi();
      allow delete: if isOwner(uid);

      // ---------- Sohbet arşivi (Revize R4) ----------
      // Yazma SUNUCUDAN (Admin SDK): sunucu her mesajı zaten görüyor,
      // moderasyon kapısı tek yerde kalıyor ve dosya başındaki UGC duruşu
      // korunuyor — serbest metne İSTEMCİ yazamıyor. İstemci yalnızca kendi
      // konuşmalarını OKUR; silme sunucu ucundan (DELETE /chat/conversations).
      match /conversations/{convId} {
        allow read: if isOwner(uid);
        allow write: if false;
        match /messages/{msgId} {
          allow read: if isOwner(uid);
          allow write: if false;
        }
      }

      // Engellenen kullanıcılar: yalnızca liste sahibi yazar/siler/okur.
      //
      // Kayıt YALNIZ SAKLANMIYOR, UYGULANIYOR (U17, App Store 1.2): aşağıda
      // friends counterpart create dalı bu dokümana bakıp engellenenin
      // yeni davet kenarını reddediyor; sunucu /notify/invite push'unu
      // ve rehber eşleşmesini de aynı kayda göre kesiyor.
      //
      // `update` neden açık: istemci engellemeyi arkadaşlık kenarlarının
      // silinmesiyle TEK batch'te yazıyor (core/safety.dart
      // kullaniciyiEngelle). Zaten engelli birine `set` motor için update
      // sayılır; update kapalıyken batch'in tamamı düşer ve kenarlar da
      // silinmezdi — ör. engellediği kişiyi sonradan yeniden ekleyip
      // tekrar engelleyen kullanıcıda.
      match /blocked/{targetUid} {
        allow read, create, update, delete: if isOwner(uid);
      }

      // ---------- Eklenen kişiler (P-turu) ----------
      // Kullanıcının kendi girdiği eş/çocuk/ebeveyn/yakın kayıtları.
      // Arkadaştan farkı: bu kişiler Rytho kullanıcısı DEĞİL, rızaları
      // alınamıyor. Bu yüzden kayıt yalnızca sahibinde durur; hiçbir
      // başka kullanıcı okuyamaz, publicProfiles'a çıkmaz, rehber
      // eşleşmesine girmez. Kişinin ADI dokümanda YOKTUR (yalnız
      // `relation`) — etiket cihazda yaşar; bkz. services/people_service.py.
      //
      // Yazma neden kapalı: kontenjan (ücretsiz 1 / Plus 10) bir ürün
      // gerçeğidir ve Firestore kuralları koleksiyon SAYAMAZ. Ekleme ve
      // silme /api/v1/people uçlarından geçer (conversations deseninin
      // aynısı); istemci yalnızca okur.
      match /people/{personId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      // Kullanıcı hafızası (memory_service), abonelik kaydı (billing) ve
      // bildirim gönderim kaydı (notification_service) — yalnızca sunucu
      // (Admin SDK) erişir; Admin SDK bu kuralları atlar.
      //
      // Gönderim kaydının istemciye kapalı olması şart: açık olsaydı kullanıcı
      // "bugün gönderildi" kaydını silip aynı bildirimi tekrar tetikleyebilirdi.
      match /private/{document=**} {
        allow read, write: if false;
      }

      // ---------- Arkadaşlık (karşılıklı onay) ----------
      // Her iki taraf da kendi listesini tutar. Davet eden kişi hem kendi
      // kaydını ('outgoing') hem karşı tarafın kaydını ('incoming') yazar;
      // bu yüzden karşı tarafa da yazma izni verilir. Serbest metin alanı yok.
      // H2 güvenlik onarımı: eski kural 'accepted'ı hem sahibe hem
      // counterpart'a serbest bırakıyordu. Sonuç: saldırgan hem kendi
      // (users/S/friends/V) hem karşı (users/V/friends/S) dokümanına
      // accepted yazıp — V hiç davet etmese de — çift taraflı arkadaşlık
      // uydurabiliyor, arkadaş olmayan biri hakkında ikili okuma/dürtme
      // tetikleyebiliyordu. Artık 'accepted' yalnız GERÇEK bir davetin
      // kabulüyle oluşur:
      //   * counterpart accepted yazabilir SADECE karşıdaki mevcut kayıt
      //     'outgoing' ise (yani sahip gerçekten davet göndermişse).
      //   * sahip accepted yazabilir SADECE kendi kaydı 'incoming' iken
      //     (yani gerçekten davet almışsa).
      // Saldırganın kurbanın ağacına yazabilmesi için kurbanın önce ona
      // 'outgoing' göndermiş olması gerekir — bu da gerçek davettir.
      match /friends/{otherUid} {
        function counterpart() {
          return signedIn() && request.auth.uid == otherUid;
        }
        function sadeceIzinliAlan() {
          return request.resource.data.keys()
            .hasOnly(['status', 'createdAt', 'updatedAt']);
        }
        allow read: if isOwner(uid);
        // Davet başlatma: sahip kendine 'outgoing', counterpart karşıya
        // 'incoming' yazar. 'accepted' create edilemez (önce davet şart).
        //
        // Engel kapısı (U17): sahip (davetin ALICISI) göndereni
        // engellediyse karşıya 'incoming' yazılamaz. Kapı yalnız bu dalda
        // yeterli: istemci iki kenarı TEK batch'te yazıyor
        // (core/friends.dart sendFriendRequest), bu yazım düşünce
        // gönderenin kendi 'outgoing' kenarı da düşer — eski paketlerde
        // de temiz bir permission-denied. Tek başına yazılmış bir
        // 'outgoing' kenarı alıcının ağacına hiçbir şey koymaz.
        // Dürtme için ayrı kapı gerekmiyor: nudges create kabul edilmiş
        // arkadaşlık istiyor ve engelleme iki kenarı da siliyor.
        allow create: if sadeceIzinliAlan() && (
          (isOwner(uid) && request.resource.data.status == 'outgoing') ||
          (counterpart() && request.resource.data.status == 'incoming'
            && !exists(/databases/$(database)/documents/users/$(uid)/blocked/$(request.auth.uid)))
        );
        allow update: if sadeceIzinliAlan() && (
          // Sahip kendi gelen davetini kabul eder.
          (isOwner(uid) && request.resource.data.status == 'accepted'
            && resource.data.status == 'incoming') ||
          // Karşı taraf, sahibin gönderdiği daveti kabul eder.
          (counterpart() && request.resource.data.status == 'accepted'
            && resource.data.status == 'outgoing')
        );
        allow delete: if isOwner(uid) || counterpart();
      }

      // ---------- Hazır tepkiler ("dürtme") ----------
      // Duolingo modeli: gönderilebilecek şey KAPALI bir kümeden seçilir,
      // serbest metin yoktur. Moderasyon yükü bu sayede sıfıra yakındır.
      // Yalnızca kabul edilmiş bir arkadaş tepki gönderebilir.
      match /nudges/{nudgeId} {
        allow read, delete: if isOwner(uid);
        allow create: if signedIn()
          && request.resource.data.fromUid == request.auth.uid
          && request.resource.data.keys().hasOnly(['fromUid', 'reaction', 'createdAt'])
          && request.resource.data.reaction in [
               'streak', 'thinking_of_you', 'shine', 'keep_going',
               'congrats', 'same_frequency', 'good_night', 'check_today',
               // R3-4 genişlemesi — mobil kReactions + api/notify.py
               // REACTION_EMOJIS ile birebir aynı olmak zorunda.
               'hug', 'luck', 'coffee', 'miss'
             ]
          && get(/databases/$(database)/documents/users/$(uid)/friends/$(request.auth.uid)).data.status == 'accepted';
        allow update: if false;
      }
    }

    // ---------- Herkese açık profil kartı ----------
    // Arkadaş listesinde gösterilen türetilmiş, hassas olmayan alanlar.
    // Ham doğum verisi BURAYA YAZILMAZ (alan listesi bunu zorunlu kılar).
    match /publicProfiles/{uid} {
      // get: tekil kart (arkadaş listesi + kullanıcı adıyla arama) çalışır.
      // list KAPALI (H2): eskiden `read` koleksiyon LİSTELEMEyi de açıyor,
      // isim+burç+lastSeenDaily davranışsal verisiyle tüm dizin
      // enumerate edilebiliyordu.
      allow get: if signedIn();
      allow list: if false;
      allow create, update: if isOwner(uid)
        && adBoyutuMakul()
        && request.resource.data.keys().hasOnly([
          'uid', 'displayName', 'photoUrl', 'username', 'sunSign',
          'streakCount', 'streakVisible', 'lastSeenDaily', 'updatedAt'
        ]);
      allow delete: if isOwner(uid);
    }

    // ---------- Kullanıcı adı rezervasyonu ----------
    // Benzersizlik `create`in var olan dokümanda başarısız olmasıyla sağlanır.
    // Devredilemez: update kapalı, sahibi silip yeniden alabilir.
    match /usernames/{username} {
      // get: kullanıcı adından uid çözme (uidForUsername) çalışır.
      // list KAPALI (H2): tüm kullanıcı adı dizininin çekilmesini önler.
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'createdAt']);
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
      allow update: if false;
    }

    // ---------- Şikayetler (yalnızca konsoldan incelenir) ----------
    match /reports/{reportId} {
      allow create: if signedIn()
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.targetType == 'user'
        && request.resource.data.targetId is string
        && request.resource.data.targetId.size() > 0
        && request.resource.data.reason is string
        && request.resource.data.reason.size() <= 500;
      allow read, update, delete: if false;
    }

    // ---------- AI önbelleği (core/cache.py) ----------
    // Instance'lar arası paylaşımlı LLM yanıt önbelleği. Yalnızca sunucu yazar
    // ve okur; istemcinin buraya erişmesi gerekmez.
    match /aiCache/{entryId} {
      allow read, write: if false;
    }

    // ---------- SMS doğrulama teşhis kaydı (phone_service.record_attempt) ----------
    // Yalnızca sunucu (Admin SDK) yazar, yalnızca konsol/panel okur.
    // İçerik MASKELİ numaradır ("+90532***4567") — ham numara buraya da
    // girmez; hash dizini (phoneHashes) doktrini aynen sürüyor.
    match /phoneAttempts/{attemptId} {
      allow read, write: if false;
    }

    // Uygulama içi geri bildirim (GB-turu): kullanıcı POST
    // /api/v1/account/feedback ile yazar, panel admin uçlarından okur ve
    // yanıtlar. İstemciye tamamen kapalı — bağlam (build/platform/dil)
    // ve günlük sınır yalnız sunucuda güvenilir.
    match /feedback/{feedbackId} {
      allow read, write: if false;
    }
  }
}
