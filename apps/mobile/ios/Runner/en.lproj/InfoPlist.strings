"NSContactsUsageDescription" = "If you turn on contact matching, phone numbers are one-way hashed on your device; only these hashes are sent for matching and they are not stored. Names and other contact details are never read.";

"NSCameraUsageDescription" = "Face reading needs access to the camera. The image is processed only on your device — it is never uploaded or stored.";

"NSPhotoLibraryUsageDescription" = "You can pick a photo from your library for face reading. The photo is processed only on your device — it is never uploaded or stored.";

"NSMicrophoneUsageDescription" = "Rytho never records audio and does not use the microphone. This permission is declared only because the camera framework requires it.";

"NSPhotoLibraryAddUsageDescription" = "Needed so you can save share cards to Photos. Rytho does not read your photos.";
