<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Uzak bildirim ortami. Bu anahtar entitlements'ta yokken iOS uygulamaya
	     APNs jetonu VERMEZ; firebase_messaging jeton bekler ve hicbir hata
	     gostermeden askida kalir. Info.plist'teki UIBackgroundModes /
	     remote-notification ile BIRLIKTE gerekir, tek basina hicbiri yetmez.

	     DEGER YAPILANDIRMAYA GORE DEGISIR ve bu sessiz bir tuzaktir: burada
	     `development` yazarken uretim arsivi alinirsa cihaz SANDBOX jetonu
	     alir, sunucu uretim APNs'ine gonderir ve bildirim hicbir yere dusmez.
	     Test derlemesinde calisir, magazada olur. Bu yuzden Release AYRI bir
	     dosya kullaniyor: Runner/RunnerRelease.entitlements (pbxproj
	     CODE_SIGN_ENTITLEMENTS, Release blogu).
	     Ikisi aps-environment DISINDA birebir ayni kalmali. -->
	<key>aps-environment</key>
	<string>development</string>

	<!-- Apple ile Giris (App Store Guideline 4.8 geregi zorunlu).
	     Bu yetenegin Apple Developer portalinda da App ID uzerinde
	     ACIK olmasi gerekir; yalnizca bu dosya yetmez. -->
	<key>com.apple.developer.applesignin</key>
	<array>
		<string>Default</string>
	</array>

	<!-- Davet baglantisi (Universal Links).
	     IKI alan adi da yazili: birincil alan adi rytho.app'e tasindi
	     (2026-09) ama rhytoai.web.app hala yayinda ve sahadaki eski
	     davet baglantilari onu tasiyor. Android tarafi da ikisini birden
	     taniyor (AndroidManifest'te iki autoVerify intent-filter).
	     Yalniz eskisi birakilsaydi yeni davetler iOS'ta uygulamayi HIC
	     acmaz, tarayiciya duserdi.
	     AASA'daki appID gercek Team ID ile yazili (292WJ9TP74.ai.rytho,
	     2026-09-27) ve pbxproj DEVELOPMENT_TEAM ile ayni olmasi
	     backend/tests/test_ios_config.py'de bekcili; ama iOS ancak
	     hosting YAYINLANDIKTAN sonra goruyor
	     (web/.well-known/apple-app-site-association). -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:rytho.app</string>
		<string>applinks:rhytoai.web.app</string>
	</array>
	<!-- App Check / App Attest ortami. Firebase App Attest kurulumu bu
	     yetenegi ister; yoksa release derlemesinde App Attest anahtari
	     uretilemez, App Check jetonu alinamaz ve Firestore + Auth
	     (ikisinde de zorlama ACIK) iOS'u reddeder. Deger IKI dosyada da
	     production: Debug zaten AppleDebugProvider kullaniyor, App Attest'e
	     hic gitmiyor. Apple Developer'da App ID uzerinde "App Attest"
	     yetenegi de ACIK olmali, yoksa imzalama duser. -->
	<key>com.apple.developer.devicecheck.appattest-environment</key>
	<string>production</string>
</dict>
</plist>
