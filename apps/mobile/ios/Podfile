# Rytho — iOS CocoaPods yapılandırması.
#
# NEDEN DEPODA DURUYOR: Flutter, Podfile yoksa şablondan üretir — ama o
# şablonda `platform :ios` satırı YORUMLU gelir (flutter_tools/templates/
# cocoapods/Podfile-ios:1-2). Satır yorumluyken CocoaPods hedefi
# Runner.xcodeproj'deki değerden okur ve çözümleme şu hatayla düşer:
#
#   The platform of the target `Runner` (iOS 13.0) is not compatible with
#   `google_mlkit_face_detection` which has a minimum requirement of iOS 15.5
#
# Yani dosya üretilse bile sorun kendiliğinden çözülmez. Bir kez elle
# düzeltip depoya koymamak, her temiz checkout'ta aynı hatayı yeniden
# ürettirir.
#
# 15.5 KEYFİ DEĞİL, paketlerin dayattığı tabandır (pub cache'ten ölçüldü):
#   google_mlkit_face_detection 0.13.2 → 15.5   (en yüksek; tavanı bu belirliyor)
#   google_mlkit_commons        0.11.1 → 15.5
#   firebase_core               4.12.1 → 15.0
#   firebase_auth / cloud_firestore / firebase_app_check → 15.0
# Düşürmek ancak yüz okumayı iOS'ta kapatmakla mümkün; bu bir ürün kararıdır
# ve alınmadı. Paketler yükseltilirse BU SATIR yeniden ölçülmeli.
platform :ios, '15.5'

# Firebase Analytics'i reklam kimligi (IDFA) destegi OLMADAN kur.
# NEDEN: Android AD_ID iznini 44'te kaldirdi ve gizlilik metni reklam
# kimligi kullanilmadigini soyluyor; iOS paketinde ise varsayilan olarak
# AdSupport + GoogleAppMeasurementIdentitySupport + GoogleAdsOnDeviceConversion
# geliyordu (olculdu 2026-09-26). Bu degisken firebase_analytics
# podspec'inde okunur ve FirebaseAnalyticsCore'u secer; SPM'deki ortam
# degiskeninin aksine her derlemede (Xcode arsivi dahil) gecerlidir.
$FirebaseAnalyticsWithoutAdIdSupport = true

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)

    # Flutter'ın kendi yardımcısı pod hedeflerinin IPHONEOS_DEPLOYMENT_TARGET
    # değerini düşürüyor ya da siliyor (podhelper.rb:83 ve :110). Bunun
    # bilinen yan etkisi, Xcode'un her derlemede yüzlerce "target overrides
    # the deployment target" uyarısı basması ve gerçek uyarıların bu gürültüde
    # kaybolması. Tabanı burada yeniden sabitliyoruz — Runner ile aynı değer.
    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.5'
    end
  end

  ml_kit_simulatorden_cikar(installer)
end

# ---------------------------------------------------------------------------
# ML Kit'i YALNIZ SİMÜLATÖR derlemesinden çıkarır.
#
# NEDEN: Google ML Kit iOS ikilileri arm64-simulator dilimi taşımıyor ve
# iOS 26+ simülatörleri yalnız arm64 çalıştırıyor. Flutter bu yüzden Runner'a
# `EXCLUDED_ARCHS[sdk=iphonesimulator*] = arm64` yazıyor — sonuç: uygulama
# bu Mac'teki HİÇBİR simülatörde açılmıyordu (ölçüldü 2026-09-26). iPhone'u
# olmayan geliştirme için simülatör tek pencere.
#
# NE YAPAR (hepsi `[sdk=iphonesimulator*]` koşullu; gerçek cihaz ve Android
# derlemesi DEĞİŞMEZ):
#   1. Pod hedeflerinde arm64 simülatör dışlamasını kaldırır.
#   2. İki eklentinin gerçek .m dosyalarını simülatörde derlemez; yerine
#      SimulatorStubs/MLKitSimulatorStubs.m aynı sınıfları ve kanal adlarını
#      sağlar, çağrıya AÇIK bir SIMULATORDE_YOK hatası döner.
#   3. ML Kit çerçevelerini Runner'ın simülatör bağlamasından çıkarır.
# Runner tarafındaki arm64 izni Flutter/Debug.xcconfig'te.
#
# Eklentiler yükseltilirse (dosya adları, kanal adları) bu blok ve yer
# tutucu dosya yeniden ölçülmeli.
# ---------------------------------------------------------------------------
ML_KIT_CERCEVELERI = %w[MLImage MLKitCommon MLKitFaceDetection MLKitVision].freeze
ML_KIT_GERCEK_KAYNAKLAR = {
  'google_mlkit_commons' =>
    'GoogleMlKitCommonsPlugin.m GenericModelManager.m MLKVisionImage+FlutterPlugin.m',
  'google_mlkit_face_detection' => 'GoogleMlKitFaceDetectionPlugin.m',
}.freeze

def ml_kit_simulatorden_cikar(installer)
  sim = '[sdk=iphonesimulator*]'
  proje = installer.pods_project

  proje.targets.each do |target|
    target.build_configurations.each do |config|
      config.build_settings["EXCLUDED_ARCHS#{sim}"] = 'i386'
      dislanan = ML_KIT_GERCEK_KAYNAKLAR[target.name]
      config.build_settings["EXCLUDED_SOURCE_FILE_NAMES#{sim}"] = dislanan if dislanan
    end
  end

  # Yer tutucu, commons hedefine eklenir; iki sınıfı da o sağlar. Cihazda
  # dosyanın içi TARGET_OS_SIMULATOR yüzünden boş derlenir.
  commons = proje.targets.find { |t| t.name == 'google_mlkit_commons' }
  if commons
    yol = File.expand_path('SimulatorStubs/MLKitSimulatorStubs.m', __dir__)
    unless commons.source_build_phase.files_references.any? { |r| r.real_path.to_s == yol }
      grup = proje.main_group.find_subpath('SimulatorStubs', true)
      commons.source_build_phase.add_file_reference(grup.new_reference(yol))
    end
  end

  installer.aggregate_targets.each do |aggregate|
    aggregate.xcconfigs.each do |ad, xcconfig|
      # CocoaPods'un ürettiği TAM satırdan yalnız ML Kit çerçeveleri silinir;
      # parça parça yeniden kurmak -force_load gibi bayrakları düşürebilirdi.
      # `$(inherited)` DA silinir: koşullu satırda o, aynı dosyadaki koşulsuz
      # satırı (ML Kit dahil) geri miras alıyordu (ölçüldü).
      bayraklar = xcconfig.to_hash['OTHER_LDFLAGS'].to_s.sub('$(inherited)', '').strip
      ML_KIT_CERCEVELERI.each { |f| bayraklar.gsub!(%( -framework "#{f}"), '') }
      xcconfig.attributes["EXCLUDED_ARCHS#{sim}"] = 'i386'
      xcconfig.attributes["OTHER_LDFLAGS#{sim}"] = bayraklar
      xcconfig.save_as(aggregate.xcconfig_path(ad))
    end
  end
end
