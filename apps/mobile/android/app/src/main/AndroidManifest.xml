<manifest xmlns:android="http://schemas.android.com/apk/res/android"
          xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>

    <!-- EKLENTILERDEN DEVRALINAN, KULLANILMAYAN IZINLER SILINIYOR.
         Kapali test denetiminde (2026-09-14) birlesmis RELEASE manifesti
         okundu; paket su izinleri istiyordu ve hicbirini kod kullanmiyor:

           RECORD_AUDIO      camera_android_camerax'ten. Kamera yalniz yuz
                             okumada ve `enableAudio: false` ile aciliyor
                             (face_capture_screen.dart:256); video kaydi
                             hic yok. Magaza listesinde "Mikrofon" yazardi
                             ve gizlilik metnimiz "mikrofona hic erisilmez"
                             diyor — beyan ile paket celisiyordu.
           READ_PHONE_STATE  tflite GPU AAR'indan ortuk geliyor. Magazada
                             "Telefon" izni olarak gorunur; bir astroloji
                             uygulamasinda kurulum oncesi guveni kirar.
           USE_BIOMETRIC     Depoda tek satir biyometrik kod yok
           USE_FINGERPRINT   (grep sifir); eklenti artigi.
           WRITE_EXTERNAL_    image_picker YALNIZ okuyor; Android 10+'ta
           STORAGE            zaten yok sayiliyor.

         READ_EXTERNAL_STORAGE BILEREK KALIYOR: image_picker eski Android
         surumlerinde galeriye onunla eriyor (avatar + yuz okuma galeri
         yolu). Onu da silmek eski cihazlarda iki akisi birden kirardi.

         `tools:node="remove"` birlestirmede eklentinin satirini duserir;
         kendi `uses-permission` satirimizi eklemez. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO"
                     tools:node="remove"/>
    <uses-permission android:name="android.permission.READ_PHONE_STATE"
                     tools:node="remove"/>
    <uses-permission android:name="android.permission.USE_BIOMETRIC"
                     tools:node="remove"/>
    <uses-permission android:name="android.permission.USE_FINGERPRINT"
                     tools:node="remove"/>
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
                     tools:node="remove"/>

    <!-- REKLAM KIMLIGI IZINLERI SILINIYOR — UYGULAMADA REKLAM YOK.
         Play Console "Reklam Kimligi" beyani (2026-09-18) kapali testi
         durdurdu: "Manifest dosyanizda com.google.android.gms.permission.AD_ID
         izni yer aliyor. Yani uygulamaniz reklam kimligi kullandigini beyan
         ediyor. Bu soruyu 'Evet' olarak yanitlayin veya bu izni manifest
         dosyanizdan kaldirin."

         Uc izin de `play-services-measurement-api` uzerinden
         firebase_analytics'ten ORTUK geliyor; kodda tek satir reklam yok.
         Dogru cevap "Evet" demek DEGIL, izni cikarmak:

           * Magaza listesinde "reklam kimligi kullaniyor" yazmaz.
           * Veri guvenligi beyani sadelesir.
           * Gizlilik metnimiz "reklam gostermiyoruz" diyor; izni tasimak
             beyanla celisirdi.

         Bedeli: Firebase Analytics reklam kimligine dayali ilistirme ve
         kitle ozelliklerini kaybeder. Kullanmiyoruz — olaylar app-instance
         kimligiyle calismaya devam eder.

         Bunlar kaldirilinca Play formunda "Hayir" isaretlenir. -->
    <uses-permission android:name="com.google.android.gms.permission.AD_ID"
                     tools:node="remove"/>
    <uses-permission android:name="android.permission.ACCESS_ADSERVICES_AD_ID"
                     tools:node="remove"/>
    <uses-permission android:name="android.permission.ACCESS_ADSERVICES_ATTRIBUTION"
                     tools:node="remove"/>

    <!-- Yuz okuma. Kare CIHAZDA islenir; sunucuya gitmez, diske yazilmaz.
         Kamera zorunlu DEGIL: uygulamanin geri kalani kamerasiz calisiyor ve
         `required="false"` olmadan Play, kamerasiz cihazlara uygulamayi hic
         gostermezdi. -->
    <uses-permission android:name="android.permission.CAMERA"/>
    <!-- Rehber eslesmesi (varsayilan KAPALI ayar): numaralar cihazda
         hash'lenir, sunucuya yalnizca SHA-256 listesi gider. -->
    <uses-permission android:name="android.permission.READ_CONTACTS"/>
    <uses-feature android:name="android.hardware.camera" android:required="false"/>
    <uses-feature android:name="android.hardware.camera.front" android:required="false"/>
    <!-- camera.any: camerax bunu `required` BELIRTMEDEN ekliyor ve Android
         varsayilani `true`. Birlesmis RELEASE manifesti okundugunda
         (kapali test denetimi, 2026-09-14) satir su hâldeydi:
             <uses-feature android:name="android.hardware.camera.any" />
         Yani yukaridaki iki `required="false"` kararimiz sessizce geri
         alinmisti: Play, kamerasiz cihazlara uygulamayi HIC gostermezdi.
         Kamera yalniz yuz okumada kullaniliyor; uygulamanin geri kalani
         kamerasiz calisiyor. `tools:replace` niteligi bizim degerimizle
         ezer. -->
    <uses-feature android:name="android.hardware.camera.any"
                  android:required="false"
                  tools:replace="android:required"/>
    <!-- allowBackup KAPALI (KT4): Android Auto Backup SharedPreferences'ı
         cihazdan cihaza taşıyor — rythoDeviceId klonlanınca tek-cihaz
         kilidi sessizce boşa düşüyordu; izin/paywall bayrakları da yeni
         cihazda bayat geliyordu. Oturum Firebase'te, veri sunucuda —
         yedeklenecek yerel kıymet yok. -->
    <application
        android:label="Rytho"
        android:name="${applicationName}"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>

            <!-- Davet baglantisi (Android App Links). IKI HOST.
                 android:autoVerify sayesinde isletim sistemi her host'un
                 /.well-known/assetlinks.json dosyasini dogrular; dogrulama
                 gecerse baglanti TARAYICI SORMADAN uygulamada acilir.

                 rytho.app  : 2026-09-15'te baglandi, YENI baglantilar bunu
                              tasiyor (core/deep_links.dart kInviteHost).
                 rhytoai.web.app : Firebase'in varsayilan adresi, kapatilamiyor.
                              Eski paylasilmis davetler yasamaya devam etsin
                              diye BILEREK duruyor. Silme.

                 Iki host ayni assetlinks.json'u sunuyor (dogrulandi), yani
                 ayni parmak izleriyle ikisi de dogrulanir.

                 Yeni bir alan adi eklenirse: buraya bir intent-filter,
                 deep_links.dart icindeki kInviteHosts kumesine bir satir. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="https"
                      android:host="rytho.app"
                      android:pathPrefix="/i/"/>
            </intent-filter>
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="https"
                      android:host="rhytoai.web.app"
                      android:pathPrefix="/i/"/>
            </intent-filter>
            <!-- Ortak baglantisi (OP): https://rytho.app/r/KOD

                 Bu filtre yalniz uygulama ZATEN KURULUYKEN is goruyor —
                 link dogrudan uygulamayi acar ve kod URL'den okunur.
                 Uygulama kurulu DEGILKEN link tarayicida acilir, sayfa
                 Play'e `&referrer=` ile yonlendirir ve kod kurulumdan
                 sonra Install Referrer'dan okunur. Iki yol da ayni
                 `POST /billing/redeem-code` ucuna cikiyor.

                 rhytoai.web.app icin AYRI bir filtre YOK: ortak
                 baglantilari yeni alan adiyla uretiliyor, eski alan adi
                 yalnizca sahadaki ESKI davet (/i/) baglantilari icin
                 duruyor. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="https"
                      android:host="rytho.app"
                      android:pathPrefix="/r/"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
