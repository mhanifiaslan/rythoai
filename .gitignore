# --- Secrets ---
.env
*.env
!*.env.example
**/serviceAccountKey.json
# RevenueCat/API anahtarlari (dart-define dosyasi); ornegi commit'lenir
dart_defines.local.json
dart_defines.test.json

# --- Python ---
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
*.egg-info/

# --- Flutter / Dart ---
apps/mobile/.dart_tool/
apps/mobile/build/
apps/mobile/.flutter-plugins
apps/mobile/.flutter-plugins-dependencies
apps/mobile/android/.gradle/
apps/mobile/android/build/
apps/mobile/android/local.properties
apps/mobile/ios/Pods/
apps/mobile/ios/.symlinks/
apps/mobile/*.iml

# --- Legacy Android ---
legacy/android/.gradle/
legacy/android/build/
legacy/android/app/build/
legacy/android/local.properties
*.iml

# --- IDE ---
.idea/
.vscode/
.DS_Store

# --- Firebase ---
.firebase/
firebase-debug.log
firestore-debug.log

# --- Misc ---
node_modules/
*.log
backend/cache/
.gradle/
apps/mobile/android/key.properties
# Apple ozel anahtarlari (APNs, Sign in with Apple; AuthKey_XXXXXXXXXX.p8):
# Apple dosyayi YALNIZ BIR KEZ indirtir ve sizarsa anahtar iptal edilip
# Firebase yapilandirmasi bastan kurulur. Depo klasorune dusen biri tek bir
# 'git add .' ile GitHub'a gitmesin.
*.p8

# Ham kaynak metinler (referans). Korpusa donusturulmus hali
# knowledge/corpus/ altinda ve o izleniyor; ham dosyayi depoya koymak
# gereksiz agirlik. Ureten: backend/scripts/ingest_*.py
knowledge/raw/

# Cihaz üstü segmentasyon modeli (~16 MB).
#
# Repoya girmiyor: git geçmişine bir kez giren ikili dosya bir daha çıkmıyor.
# Apache 2.0 ve Google'ın kalıcı adresinden indiriliyor; kurulum tek komut:
#   apps/mobile/scripts/fetch_models.ps1
#
# Tersini isterseniz bu satırı silip dosyayı commit'lemek yeterli.
apps/mobile/assets/models/*.tflite

# RD-turu: kitap chunk'larinin kanonik kopyasi knowledge/corpus/books/ altinda
# (git'te); buradaki ham cikti kopyasi ~60MB tekrar olurdu. Kanit zinciri
# README + manifest + stats + clean ile korunuyor.
docs/rag_corpus/chunks/

# Magaza gorselleri: ham cihaz kayitlari kisisel veri tasiyor
# (gercek ad, dogum haritasi) — yalniz uretilmis varliklar versiyonlanir.
store/play/raw/
# App Store ham yakalamalari (simulator, demo hesap): nihai kareler
# Higgsfield kurgusundan sonra uretilmis varlik olarak eklenir.
store/app-store/raw/

# Reklam varliklari git'e GIRMEZ (4,9 GB olculdu). Ham cihaz kayitlari
# kisisel veri tasiyor (gercek dogum haritasi), uretilmis kareler ve
# kurgu ciktilarinin ise git'te durmasi depoyu kullanilmaz hale getirir.
# Versiyonlanan tek sey URETICI BETIKLER ve README — cikti onlardan
# yeniden uretilebilir. Nihai mp4'ler dis paylasimla dagitilir.
ads/*/plates/
ads/*/clips/
ads/*/cut*/
ads/*/frames/
ads/*/keyframes/
ads/*/reklam/
ads/*/rough/
ads/*/ses/
ads/*/shots/
ads/*/fonts/
ads/*/__pycache__/
ads/*/*.mp4
# Kehanet sahnesi hatti (ads/oracle-anim): ham still/klipler ve ffmpeg ciktilari
ads/*/raw/
ads/*/stills/
ads/*/out/
ads/*/*.png
ads/*/*.wav
ads/*/*.webp
ads/*/mock/*.png
